<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Smash Phil</Authors>
    <Description>SDK for benchmarking and unit testing in RimWorld.</Description>
    <Product>DevTools</Product>
    <RootNamespace>DevTools</RootNamespace>
    <AssemblyName>DevTools</AssemblyName>

    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseKrafsPackageRef)' == 'true' AND '$(AnalyzerProject)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4979-alpha" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseKrafsPackageRef)' != 'true' AND '$(AnalyzerProject)' != 'true'">
    <Reference Include="System">
      <HintPath>$(RefDir)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <HintPath>$(RefDir)\System.Xml.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml.Linq">
      <HintPath>$(RefDir)\System.Xml.Linq.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>$(RefDir)\mscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images/Icon_TestPassed.png" />
    <EmbeddedResource Include="Images/Icon_TestFailed.png" />
    <EmbeddedResource Include="Images/Icon_TestRunning.png" />
    <EmbeddedResource Include="Images/Icon_TestCanceled.png" />
    <EmbeddedResource Include="Images/Icon_TestNotRan.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Generated\" />
  </ItemGroup>
</Project>
